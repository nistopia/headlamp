# wsl-config.env — AKS Arc on WSL setup config.
# Copy to `wsl-config.env` and fill in. Plain KEY=VALUE (no spaces around '=').
# Gitignored — do NOT commit your filled copy. Details: README.md.
# Constants (API versions, HCI roles, C2E appId, ADO/BMAgent paths) are baked
# into the script defaults; add a line here only to override one.

# k8s (kubeadm) or k3s. k3s needs a CMP whose operator defaults to K3s.
DISTRIBUTION=k8s

# Dev CMP context (edge resources reuse the CMP's subscription + resource group).
CMP_SUB=<your-subscription-id>
CMP_RG=<your-resource-group>
CMP_AKS=aks-cl
CMP_CONN=aks-conn-cl
CMP_LOCATION=eastus2euap

EDGE_LOCATION=eastus2euap
TENANT_ID=<your-tenant-id>

# Full SFF-pinned version "<semver>-<date>"; list: az aksarc get-versions ...
K8S_VERSION=1.33.3-20251001

# Private aksarc wheel (needs --network-policy). Empty = skip, verify current CLI.
# Quote paths with spaces. WSL (/mnt/c/...) or distro path.
AKSARC_WHEEL_PATH=

# Optional toggles (default false).
ENABLE_GPU=false
ENABLE_BMAGENT_HOTSWAP=false
