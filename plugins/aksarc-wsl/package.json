{
  "name": "aksarc-wsl",
  "version": "0.1.0",
  "description": "Create an AKS Arc (SFF/BareMetal) edge cluster on WSL2 directly from Headlamp.",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build && npm run copy-runtime",
    "copy-runtime": "shx cp manage-aksarc-wsl.js dist/ && shx cp -r scripts dist/",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "tsc": "headlamp-plugin tsc",
    "test": "headlamp-plugin test"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "aks-arc",
    "wsl",
    "azure"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0",
    "shx": "^0.3.4"
  },
  "overrides": {
    "typescript": "5.6.2"
  }
}
